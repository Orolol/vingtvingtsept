{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schemas.vingtvingtsept.invalid/v1/polls.json",
	"title": "Polls",
	"description": "Tous les sondages intégrés au run (premier et second tour) et effets maison estimés par institut.",
	"type": "object",
	"additionalProperties": false,
	"required": ["asof", "pollsters", "polls", "house_effects", "pollster_ratings", "dispersion", "turnout_gap"],
	"$defs": {
		"pollster": {
			"title": "Pollster",
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "name"],
			"properties": {
				"id": { "$ref": "common.json#/$defs/pollster_id" },
				"name": { "type": "string" }
			}
		},
		"hypothesis": {
			"title": "PollHypothesis",
			"description": "Une hypothèse testée : liste de candidats (premier tour) ou duel (second tour), une population.",
			"type": "object",
			"additionalProperties": false,
			"required": ["hypothesis_id", "round", "population", "shares"],
			"properties": {
				"hypothesis_id": { "type": "string" },
				"round": { "type": "integer", "enum": [1, 2] },
				"population": { "$ref": "common.json#/$defs/population" },
				"shares": {
					"type": "array",
					"description": "Parts publiées en points d'exprimés, dans l'ordre décroissant.",
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["candidate_id", "share"],
						"properties": {
							"candidate_id": { "$ref": "common.json#/$defs/candidate_id" },
							"share": { "$ref": "common.json#/$defs/share" }
						}
					},
					"minItems": 2
				}
			}
		},
		"poll": {
			"title": "Poll",
			"type": "object",
			"additionalProperties": false,
			"required": [
				"poll_id",
				"pollster",
				"sponsor",
				"fieldwork_start",
				"fieldwork_end",
				"publish_date",
				"sample_size",
				"mode",
				"source_url",
				"hypotheses"
			],
			"properties": {
				"poll_id": { "type": "string", "description": "Clé de la table curated `polls`." },
				"pollster": { "$ref": "common.json#/$defs/pollster_id" },
				"sponsor": { "type": ["string", "null"], "description": "Commanditaire(s)." },
				"fieldwork_start": { "$ref": "common.json#/$defs/date" },
				"fieldwork_end": { "$ref": "common.json#/$defs/date" },
				"publish_date": { "anyOf": [{ "$ref": "common.json#/$defs/date" }, { "type": "null" }] },
				"sample_size": { "type": ["integer", "null"], "minimum": 1 },
				"mode": { "type": "string", "enum": ["online", "phone", "mixed", "unknown"] },
				"source_url": { "type": ["string", "null"], "description": "Notice de la Commission des sondages, ou page source." },
				"hypotheses": { "type": "array", "items": { "$ref": "#/$defs/hypothesis" }, "minItems": 1 }
			}
		},
		"house_effect": {
			"title": "HouseEffect",
			"description": "Effet maison estimé de l'institut sur un bloc, en points d'exprimés (positif = l'institut surestime le bloc par rapport au consensus).",
			"type": "object",
			"additionalProperties": false,
			"required": ["pollster", "bloc", "effect", "n_polls"],
			"properties": {
				"pollster": { "$ref": "common.json#/$defs/pollster_id" },
				"bloc": { "$ref": "common.json#/$defs/bloc" },
				"effect": { "$ref": "common.json#/$defs/interval" },
				"n_polls": { "type": "integer", "minimum": 0 }
			}
		},
		"pollster_rating": {
			"title": "PollsterRating",
			"description": "Ligne du palmarès 2002-2022 (runs/<date>-pollster-ratings/palmares.parquet), par lignée d'instituts.",
			"type": "object",
			"additionalProperties": false,
			"required": ["pollster", "name", "elections", "n_polls", "n_final", "mae_candidate", "mae_bloc", "relative_error", "bias", "precision", "n_better", "n_rated"],
			"properties": {
				"pollster": { "$ref": "common.json#/$defs/pollster_id" },
				"name": { "type": "string" },
				"elections": { "type": "array", "items": { "type": "integer" } },
				"n_polls": { "type": "integer", "minimum": 0, "description": "Sondages de premier tour des campagnes." },
				"n_final": { "type": "integer", "minimum": 0, "description": "Sondages des 21 derniers jours." },
				"mae_candidate": {
					"type": ["number", "null"],
					"minimum": 0,
					"description": "Erreur absolue moyenne par candidat du dernier sondage, en points."
				},
				"mae_bloc": {
					"type": ["number", "null"],
					"minimum": 0,
					"description": "Erreur absolue moyenne par bloc du dernier sondage, en points."
				},
				"relative_error": {
					"type": ["number", "null"],
					"description": "Écart d'erreur à l'institut moyen de l'élection, en points (négatif = meilleur)."
				},
				"bias": {
					"type": "object",
					"additionalProperties": false,
					"description": "Biais signé moyen par bloc du dernier sondage (sondage − résultat), en points.",
					"required": ["far_right", "right", "centre", "left", "far_left"],
					"properties": {
						"far_right": { "type": ["number", "null"] },
						"right": { "type": ["number", "null"] },
						"centre": { "type": ["number", "null"] },
						"left": { "type": ["number", "null"] },
						"far_left": { "type": ["number", "null"] }
					}
				},
				"precision": {
					"type": ["number", "null"],
					"description": "Précision relative x, moyenne sur les élections (négatif = plus précis)."
				},
				"n_better": { "type": "integer", "minimum": 0, "description": "Élections où l'institut bat l'institut moyen." },
				"n_rated": { "type": "integer", "minimum": 0, "description": "Élections notées." }
			}
		},
		"pollster_ratings": {
			"title": "PollsterRatings",
			"description": "Palmarès des instituts et stabilité du classement d'une élection à la suivante. Volet explicatif : le palmarès a été testé et n'est pas admis (docs/backtest-log.md).",
			"type": "object",
			"additionalProperties": false,
			"required": ["in_forecast", "note", "elections", "rows", "stability"],
			"properties": {
				"in_forecast": { "type": "boolean" },
				"note": { "type": "string" },
				"elections": { "type": "array", "items": { "type": "integer" } },
				"rows": { "type": "array", "items": { "$ref": "#/$defs/pollster_rating" } },
				"stability": {
					"type": "array",
					"description": "Corrélation poolée entre élections consécutives.",
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["id", "label", "n_pairs", "pearson", "p"],
						"properties": {
							"id": { "type": "string" },
							"label": { "type": "string" },
							"n_pairs": { "type": "integer", "minimum": 0 },
							"pearson": { "type": ["number", "null"], "minimum": -1, "maximum": 1 },
							"p": { "anyOf": [{ "$ref": "common.json#/$defs/probability" }, { "type": "null" }] }
						}
					}
				}
			}
		}
	},
	"properties": {
		"asof": { "$ref": "common.json#/$defs/date" },
		"pollsters": { "type": "array", "items": { "$ref": "#/$defs/pollster" } },
		"polls": {
			"type": "array",
			"description": "Par fin de terrain décroissante.",
			"items": { "$ref": "#/$defs/poll" }
		},
		"house_effects": { "type": "array", "items": { "$ref": "#/$defs/house_effect" } },
		"pollster_ratings": { "$ref": "#/$defs/pollster_ratings" },
		"dispersion": {
			"title": "PollsterDispersion",
			"description": "Dispersion relative D des instituts (vvs.model.herding) : observée / attendue sous tirage aléatoire, un sondage par institut sur `window_days` jours. Volet explicatif, hors prévision (runs/2026-10-22-herding).",
			"type": "object",
			"additionalProperties": false,
			"required": ["in_forecast", "note", "reading", "window_days", "weeks", "D", "reference", "n_pollsters", "current", "past_same_horizon"],
			"properties": {
				"in_forecast": { "type": "boolean" },
				"note": { "type": "string" },
				"reading": { "type": "string" },
				"window_days": { "type": "integer", "minimum": 1 },
				"weeks": {
					"type": "array",
					"items": { "$ref": "common.json#/$defs/date" },
					"description": "Dates de calcul, une par semaine ; la dernière vaut asof."
				},
				"D": {
					"type": "array",
					"items": { "type": ["number", "null"], "minimum": 0 },
					"description": "D 2027 à chaque date ; null sous quatre instituts."
				},
				"reference": {
					"type": "array",
					"items": { "type": ["number", "null"], "minimum": 0 },
					"description": "D_ref : moyenne géométrique de D aux présidentielles 2002-2022 au même nombre de jours du vote."
				},
				"n_pollsters": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
				"current": {
					"type": "object",
					"additionalProperties": false,
					"required": ["asof", "horizon_days", "D", "reference", "pollsters"],
					"properties": {
						"asof": { "$ref": "common.json#/$defs/date" },
						"horizon_days": { "type": "integer" },
						"D": { "type": ["number", "null"], "minimum": 0 },
						"reference": { "type": ["number", "null"], "minimum": 0 },
						"pollsters": { "type": "array", "items": { "$ref": "common.json#/$defs/pollster_id" } }
					}
				},
				"past_same_horizon": {
					"type": "array",
					"description": "D de chaque présidentielle passée au même nombre de jours du vote (null : moins de quatre instituts).",
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["election", "D"],
						"properties": { "election": { "type": "integer" }, "D": { "type": ["number", "null"], "minimum": 0 } }
					}
				}
			}
		},
		"turnout_gap": {
			"title": "TurnoutGap",
			"description": "Électorats fragiles : écart certains d'aller voter − inscrits par candidat en 2027, premier tour, sondages publiant les deux bases (data/curated/turnout_gap.parquet). Volet explicatif, hors prévision (runs/2026-10-22-turnout-gap).",
			"type": "object",
			"additionalProperties": false,
			"required": ["in_forecast", "note", "history", "pollsters", "n_polls", "first_poll", "last_poll", "rows"],
			"properties": {
				"in_forecast": { "type": "boolean" },
				"note": { "type": "string" },
				"history": { "type": "string", "description": "Ce que sont devenus ces électorats en 2017 et en 2022." },
				"pollsters": { "type": "array", "items": { "type": "string" } },
				"n_polls": { "type": "integer", "minimum": 0 },
				"first_poll": { "anyOf": [{ "$ref": "common.json#/$defs/date" }, { "type": "null" }] },
				"last_poll": { "anyOf": [{ "$ref": "common.json#/$defs/date" }, { "type": "null" }] },
				"rows": {
					"type": "array",
					"description": "Triées par écart croissant (les plus fragiles d'abord).",
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["candidate_id", "gap", "se", "share_certain", "share_registered", "n_polls", "last_poll"],
						"properties": {
							"candidate_id": { "$ref": "common.json#/$defs/candidate_id" },
							"gap": {
								"type": "number",
								"description": "Part chez les certains − part chez les inscrits, en points d'exprimés ; moyenne des sondages."
							},
							"se": {
								"type": ["number", "null"],
								"minimum": 0,
								"description": "Erreur-type (écart type entre sondages / √n) ; null sous deux sondages."
							},
							"share_certain": { "$ref": "common.json#/$defs/share" },
							"share_registered": { "$ref": "common.json#/$defs/share" },
							"n_polls": { "type": "integer", "minimum": 1 },
							"last_poll": { "$ref": "common.json#/$defs/date" }
						}
					}
				}
			}
		}
	}
}
